# Variáveis do frontend (expostas ao navegador).
#
# SOMENTE valores públicos entram aqui. A chave de serviço (service_role) e
# qualquer segredo administrativo NUNCA podem ser colocados em VITE_*: tudo com
# esse prefixo vai para o bundle e fica visível para quem abrir a página.
#
# Copie para .env.local e preencha com os dados do SEU projeto de homologação.

# Painel do Supabase → Project Settings → Data API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Painel do Supabase → Project Settings → API Keys → anon / publishable
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANONIMA

# Base usada para montar os links de retorno de e-mail e de convite.
# Em desenvolvimento, http://localhost:5173
VITE_URL_APLICACAO=http://localhost:5173

# Modo demonstração (dados fictícios no navegador, sem login).
# Deixe vazio na aplicação integrada; `npm run dev:demo` já define isto.
# VITE_MODO=demo
